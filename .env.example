# ==========================================
# Reply Agent Environment Variables Configuration
# Copy this file to .env and insert your real API key(s)
# DO NOT COMMIT THE .env FILE TO GIT!
# ==========================================

# LLM Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Active LLM Provider Selection (groq, gemini, openai, anthropic)
LLM_PROVIDER=groq
LLM_MODEL=groq/compound
LLM_JUDGE_MODEL=groq/compound

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
